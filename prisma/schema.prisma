// Personal Finance Assistant AI Agent — Prisma schema
// Topic A: PBCSF International Track

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  tier      String   @default("Viewer") // Viewer | Editor | Approver
  privacyMode Boolean @default(false)
  passwordHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions    Transaction[]
  budgets         Budget[]
  goals           Goal[]
  debts           Debt[]
  notifications   Notification[]
  conversations   Conversation[]
  recommendations Recommendation[]
  settings        UserSettings?
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  // Profile
  displayName          String   @default("")
  avatarColor          String   @default("#6366f1")
  // Appearance
  theme                String   @default("light") // light | dark
  density              String   @default("comfortable") // compact | comfortable | spacious
  // Localization
  currency             String   @default("USD")
  dateFormat           String   @default("MMM d, yyyy") // MMM d, yyyy | DD/MM/YYYY | YYYY-MM-DD
  numberFormat         String   @default("en-US") // en-US | de-DE | ja-JP
  firstDayOfWeek       Int      @default(0) // 0=Sunday, 1=Monday
  // Notifications
  notifInsights        Boolean  @default(true)
  notifBills           Boolean  @default(true)
  notifAnomalies       Boolean  @default(true)
  notifRecommendations Boolean  @default(true)
  notifBudgetAlerts    Boolean  @default(true)
  notifWeeklyDigest    Boolean  @default(false)
  // Agent
  agentResponseStyle   String   @default("professional") // professional | casual | detailed
  agentDefaultMode     String   @default("auto") // auto | quick_qa | monthly_review
  agentAutoRefresh     Boolean  @default(true)
  agentConfirmWrites   Boolean  @default(true)
  // Analytics
  analyticsReturnRate  Float    @default(0.07) // assumed annual investment return
  analyticsInflation   Float    @default(0.025) // assumed inflation rate
  analyticsVolatility  Float    @default(0.15) // Monte Carlo volatility
  // Privacy
  shareAggregates      Boolean  @default(true) // share anonymized data for peer benchmarking
  // LLM Provider
  llmProvider          String   @default("zai") // zai | openai | anthropic | custom
  llmApiKey            String   @default("")
  llmModel             String   @default("") // e.g. gpt-4o, claude-3-5-sonnet, llama3.1
  llmBaseUrl           String   @default("") // for custom providers (e.g. http://localhost:11434/v1)
  // Onboarding
  onboardingState      String?  // JSON array of completed step IDs
  currentAge           Int      @default(30)
  // Timestamps
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "dining", "groceries", "transport"
  icon      String?
  color     String   // hex color for charts
  createdAt DateTime @default(now())

  transactions Transaction[]
  budgets      Budget[]
}

model Transaction {
  id             String   @id @default(cuid())
  userId         String
  categoryId     String
  date           DateTime
  amountCents    Int      // positive integer; direction tracked separately
  direction      String   @default("debit") // debit | credit
  currency       String   @default("USD")
  merchantRaw    String
  merchantNorm   String
  memo           String?
  source         String   @default("csv") // csv | pdf | ocr | voice | manual
  confidence     Float    @default(1.0)
  recurring      Boolean  @default(false)
  anomaly        Boolean  @default(false)
  anomalyScore   Float?
  createdAt      DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId, date])
  @@index([userId, categoryId])
}

model Budget {
  id           String  @id @default(cuid())
  userId       String
  categoryId   String
  amountCents  Int     // monthly envelope allocation
  month        String  // "2026-04" format
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month])
}

model Goal {
  id           String   @id @default(cuid())
  userId       String
  name         String   // e.g. "Trip to Japan"
  targetCents  Int
  savedCents   Int      @default(0)
  monthlyContributionCents Int
  targetDate   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New conversation")
  mode      String   @default("quick_qa") // quick_qa | monthly_review | goal_planning
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user | assistant | tool
  content        String
  toolCalls      String?  // JSON string of tool invocations
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Recommendation {
  id           String   @id @default(cuid())
  userId       String
  template     String   // "cancel_subscription" | "defer_purchase" | "rebalance_budget" etc.
  title        String
  detail       String
  impactCents  Int      // estimated annual savings
  confidence   String   @default("high") // high | medium | low
  evidence     String   // JSON string with transaction references
  status       String   @default("pending") // pending | accepted | dismissed
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Debt {
  id              String   @id @default(cuid())
  userId          String
  name            String
  category        String   @default("Credit Card") // Credit Card | Student Loan | Auto Loan | Personal Loan | Mortgage | Other
  balanceCents    Int
  apr             Float    // e.g. 0.1999 for 19.99%
  minPaymentCents Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   // bill | budget | anomaly | rec | system
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

