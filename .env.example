# ─── FinWise Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit .env — it is in .gitignore.

# Path to your local SQLite database file
DATABASE_URL="file:./db/custom.db"

# Secret key used to sign session tokens.
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
# Or:            openssl rand -hex 32
AUTH_SECRET="replace-with-a-strong-random-hex-string"

# ─── Optional: AI Agent (Settings → AI Agent in the app) ────────────────────
# These are set per-user in the app's settings UI, not here.
# LLM_PROVIDER=openai          # openai | anthropic | custom
# LLM_API_KEY=sk-...           # Your provider API key
